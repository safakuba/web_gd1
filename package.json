{
  "name": "watch-time-study",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:audit": "node scripts/audit-models.mjs",
    "models:dedupe": "node scripts/dedupe-glb-images.mjs",
    "models:transplant-animation": "node scripts/transplant-glb-animation.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run assets:audit && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
